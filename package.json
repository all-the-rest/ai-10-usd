{
  "name": "ai-10-usd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/build-comparison.mjs",
    "dev": "vite",
    "build": "pnpm generate && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "test:screenshots": "playwright test -c playwright.screenshots.config.ts",
    "test:contrast": "playwright test -c playwright.contrast.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "svelte": "^5.56.10"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.90",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "daisyui": "^5.7.22",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
